# Copiá este archivo a .env y completá. NO se commitea (.env está en .gitignore).
#
# URL del proyecto API en Vercel (Root Directory = apps/api). Ver DEPLOY.md.
SR_API=https://stockrapido-api.vercel.app
SR_EMAIL=tu-email-stockrapido
SR_PASSWORD=tu-password-stockrapido

# Las credenciales de Mondelez, Juntos+ y Tokin se gestionan dentro de
# StockRápido, en Configuración → Proveedores. Los runners las consultan usando
# este usuario y guardan allí mismo la sesión capturada.

# --- ARCA Mis Comprobantes Recibidos (arca_recibidos_sync_runner.py) ---
# Alternativa local al token Afip SDK: login Clave Fiscal + ajax del portal.
AFIP_CUIT=20123456789
AFIP_PASSWORD=tu-clave-fiscal
AFIP_HEADLESS=1
# AFIP_FROM=2026-01-01
# AFIP_TO=2026-03-31
