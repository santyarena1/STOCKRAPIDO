# Copiá este archivo a .env y completá los valores (opcional si ya configurás todo en la app:
# Configuración → Compras con IA).
# La API carga .env automáticamente (no subas .env al repo).

# URL del webhook de ENTRADA en N8N (también editable en Configuración → Compras con IA).
N8N_INVOICE_WEBHOOK_URL=

# Secreto del callback (también en Configuración). N8N lo envía en X-Webhook-Secret.
AI_INVOICE_WEBHOOK_SECRET=

# URL pública de esta API en Vercel (también en Configuración).
PUBLIC_API_URL=https://stockrapido-api.vercel.app

PORT=4002

# Sesión: por defecto 365 días (access y refresh). Ejemplos: 90d, 365d, 10y
# JWT_ACCESS_EXPIRES=365d
# JWT_REFRESH_EXPIRES=365d

# Panel admin (emails separados por coma)
# SUPER_ADMIN_EMAILS=tu@email.com
# Super admin de plataforma (se crea al arrancar la API): admin@admin.com / Santy1234

# Fidelización funciona sin Wallet configurado.
# APPLE_WALLET_ENABLED=false
# APPLE_PASS_TYPE_IDENTIFIER=pass.com.stockrapido.loyalty
# APPLE_TEAM_IDENTIFIER=
# APPLE_WALLET_CERT=
# APPLE_WALLET_KEY=
# APPLE_WALLET_CERT_PASSWORD=
# APPLE_WALLET_WWDR_CERT=
# APPLE_WALLET_APNS_KEY=
# APPLE_WALLET_APNS_KEY_ID=
# GOOGLE_WALLET_ENABLED=false
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_CLASS_ID=
# GOOGLE_WALLET_SERVICE_ACCOUNT_BASE64=
