generator client {
  provider      = "prisma-client-js"
  // "native" para build local; rhel-openssl-3.0.x para el runtime serverless de Vercel
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Pooled (pgBouncer de Neon) para el runtime serverless
  url       = env("DATABASE_URL")
  // Conexion directa para migraciones (prisma migrate / db push)
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  CAJERO
  REPOSITOR
  LECTOR
}

model Business {
  id        String   @id @default(cuid())
  name      String
  cuit      String?
  address   String?
  currency  String   @default("ARS")
  posConfig Json?
  openaiKeyEncrypted String?
  serperKeyEncrypted String?
  planId       String    @default("mostrador")
  planStatus   String    @default("active") // trial | active | pending_payment | past_due | canceled
  billingCycle String    @default("monthly") // monthly | yearly
  trialEndsAt  DateTime?
  planRenewsAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  products  Product[]
  categories Category[]
  sales     Sale[]
  cashRegisters CashRegister[]
  customers Customer[]
  suppliers  Supplier[]
  purchases  Purchase[]
  pausedSales PausedSale[]
  promos    Promo[]
  syncConnections SyncConnection[]
  stickerCountries    StickerCountry[]
  stickers            Sticker[]
  stickerCatalogShare StickerCatalogShare?
  stickerOrders       StickerOrder[]
  fiscalConfig        FiscalConfig?
  fiscalDocuments     FiscalDocument[]
  vendedores          Vendedor[]
  vendedorSessions    VendedorSession[]
  dataBackups          DataBackup[]
  invoices             Invoice[]
  supportTickets       SupportTicket[]
  consignmentParties   ConsignmentParty[]
  consignmentLedger    ConsignmentLedgerEntry[]
  consignmentPayments  ConsignmentPayment[]
}

model Invoice {
  id             String    @id @default(cuid())
  businessId     String
  planId         String
  cycle          String
  amount         Decimal
  currency       String    @default("ARS")
  status         String    @default("pending") // pending | paid | failed | void
  periodStart    DateTime
  periodEnd      DateTime
  paidAt         DateTime?
  method         String?
  notes          String?
  mpPreferenceId String?
  mpPaymentId    String?
  createdAt      DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}

model Promo {
  id              String    @id @default(cuid())
  businessId      String
  name            String
  description     String?
  type            String    // 'percent' | 'fixed' | 'bogo' | 'precio_fijo'
  value           Decimal   // % descuento, monto fijo, precio total combo, o cantidad gratis (bogo)
  buyQty          Int?      // para bogo: comprar N
  getQtyFree      Int?      // para bogo: llevar M gratis
  minPurchase     Decimal?  @default(0)  // monto mínimo del carrito
  productIds      String?   // JSON array de IDs (legacy)
  productItems    String?   // JSON [{ productId, qty }] para combos con cantidades
  categoryIds     String?   // JSON array de IDs
  promoCode       String?   // código opcional (ej: VERANO20)
  validFrom       DateTime?
  validTo         DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  passwordHash String
  name       String
  role       Role     @default(CAJERO)
  businessId String
  isActive   Boolean  @default(true)
  isPlatformAdmin Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  auditLogs           AuditLog[]
  sales               Sale[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  supportTickets      SupportTicket[]
  supportMessages     SupportMessage[]
}

model Category {
  id         String   @id @default(cuid())
  name       String
  businessId String
  createdAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  business  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products  Product[]
}

model Product {
  id          String    @id @default(cuid())
  name        String
  barcode     String?
  categoryId  String?
  cost        Decimal?
  price       Decimal
  stock       Int       @default(0)
  minStock    Int       @default(0)
  stockControl Boolean  @default(true)
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  incomplete  Boolean   @default(false)
  silent      Boolean   @default(false)
  consigned   Boolean   @default(false)
  consignmentPartyId String?
  /** % sobre la base (costo o venta según la entidad); null = default de la entidad */
  consignmentCommissionPercent Decimal?
  businessId  String
  brand       String?
  iva         Decimal?
  imageUrl    String?
  unitsPerBox String?
  weight      String?
  format      String?
  flavor      String?
  presentation String?
  subcategory String?
  supplierSku String?
  supplierRef String?
  externalId  String?
  eanBox      String?
  allCodes    String?   // todos los códigos concatenados (unidad/display/bulto/ref/sku) para filtrar por cualquiera
  sourceConnectionId String?
  sourceProvider String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  consignmentParty ConsignmentParty? @relation(fields: [consignmentPartyId], references: [id], onDelete: SetNull)
  saleItems   SaleItem[]
  stockMoves StockMove[]
  purchaseItems PurchaseItem[]
  batches   ProductBatch[]
  consignmentLedger ConsignmentLedgerEntry[]

  @@index([businessId, consigned])
  @@index([consignmentPartyId])
}

/** Persona/entidad dueña de productos en consignación (comisionados). */
model ConsignmentParty {
  id                       String   @id @default(cuid())
  businessId               String
  name                     String
  notes                    String?
  defaultCommissionPercent Decimal  @default(0)
  /** 'cost' = % sobre costo; 'sale' = % sobre precio de venta */
  commissionBase           String   @default("cost")
  active                   Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  business  Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products  Product[]
  ledger    ConsignmentLedgerEntry[]
  payments  ConsignmentPayment[]

  @@index([businessId, active])
}

/** Deuda generada al vender un producto comisionado. */
model ConsignmentLedgerEntry {
  id                 String   @id @default(cuid())
  businessId         String
  partyId            String
  productId          String?
  saleId             String?
  saleItemId         String?
  qty                Int
  unitCost           Decimal
  commissionPercent  Decimal  @default(0)
  amount             Decimal
  note               String?
  voided             Boolean  @default(false)
  createdAt          DateTime @default(now())

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  party    ConsignmentParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  product  Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([businessId, partyId, createdAt])
  @@index([saleId])
}

/** Pagos parciales a la entidad comisionada. */
model ConsignmentPayment {
  id         String   @id @default(cuid())
  businessId String
  partyId    String
  amount     Decimal
  note       String?
  createdAt  DateTime @default(now())

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  party    ConsignmentParty @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([businessId, partyId, createdAt])
}

model Sale {
  id             String   @id @default(cuid())
  businessId     String
  userId         String
  customerId     String?
  total          Decimal
  discount       Decimal  @default(0)
  totalFinal     Decimal
  paymentMethod  String?
  cashRegisterId String?
  synced         Boolean   @default(true)
  status         String    @default("completed")
  createdAt      DateTime  @default(now())
  voidReason     String?
  voidedAt       DateTime?
  voidedById     String?
  sellerId       String?

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id])
  customer     Customer?     @relation(fields: [customerId], references: [id])
  cashRegister CashRegister? @relation(fields: [cashRegisterId], references: [id])
  items        SaleItem[]
  fiscalDocument FiscalDocument?
  seller       Vendedor?      @relation(fields: [sellerId], references: [id])
}

model Vendedor {
  id         String   @id @default(cuid())
  businessId String
  name       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sessions VendedorSession[]
  sales    Sale[]

  @@index([businessId, active])
}

model VendedorSession {
  id         String    @id @default(cuid())
  businessId String
  vendedorId String
  startedAt  DateTime  @default(now())
  endedAt    DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  vendedor Vendedor @relation(fields: [vendedorId], references: [id], onDelete: Cascade)

  @@index([businessId, endedAt])
  @@index([vendedorId, startedAt])
}

model DataBackup {
  id         String   @id @default(cuid())
  businessId String
  category   String
  payload    Json
  rowCount   Int      @default(0)
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, category])
  @@index([expiresAt])
}

model FiscalConfig {
  id                    String   @id @default(cuid())
  businessId            String   @unique
  enabled               Boolean  @default(false)
  environment           String   @default("homologation")
  cuit                   String
  pointOfSale            Int
  legalName              String?
  grossIncomeNumber      String?
  activityStartDate      DateTime?
  address                String?
  certificateEncrypted   String?
  privateKeyEncrypted    String?
  certificateExpiresAt  DateTime?
  /// Aviso de tope facturado: avisa antes de emitir la próxima Factura C.
  invoiceAlertEnabled    Boolean  @default(false)
  invoiceAlertLimit      Decimal?
  /// Porcentaje del límite a partir del cual se muestra el aviso (ej. 80).
  invoiceAlertPercent    Int      @default(80)
  /// calendar_month | rolling_30 | all_time
  invoiceAlertPeriod     String   @default("calendar_month")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model FiscalDocument {
  id             String   @id @default(cuid())
  businessId     String
  saleId         String   @unique
  kind           String
  status         String
  pointOfSale    Int?
  receiptType    Int?
  receiptNumber  Int?
  cae             String?
  caeExpiresAt   DateTime?
  qrPayload      String?
  errorMessage   String?
  arcaResult     Json?
  creditNoteType         Int?
  creditNoteNumber       Int?
  creditNoteCae          String?
  creditNoteCaeExpiresAt DateTime?
  creditNoteQr           String?
  creditNoteResult       Json?
  voidedAt               DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@unique([businessId, pointOfSale, receiptType, receiptNumber])
}

model SaleItem {
  id         String   @id @default(cuid())
  saleId     String
  productId  String?
  productName String?  // para ítem manual cuando productId es null
  qty        Int
  unitPrice  Decimal
  subtotal   Decimal
  discount   Decimal  @default(0)

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model CashRegister {
  id          String    @id @default(cuid())
  businessId  String
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  openingCash Decimal
  openingBank Decimal   @default(0)
  closingCash Decimal?
  closingBank Decimal?
  userId      String?
  notes       String?

  business  Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales     Sale[]
  movements CashMovement[]
}

model CashMovement {
  id              String   @id @default(cuid())
  cashRegisterId String
  type            String
  amount          Decimal
  category        String?
  note            String?
  reference       String?
  createdAt       DateTime @default(now())

  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
}

model Customer {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  phone       String?
  notes       String?
  balance     Decimal  @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business  Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales     Sale[]
  payments  CustomerPayment[]
}

model CustomerPayment {
  id         String   @id @default(cuid())
  customerId String
  amount     Decimal
  note       String?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Supplier {
  id         String   @id @default(cuid())
  businessId String
  name       String
  phone      String?
  email      String?
  address    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchases Purchase[]
}

model Purchase {
  id         String   @id @default(cuid())
  businessId String
  supplierId String
  total      Decimal
  createdAt  DateTime  @default(now())

  business  Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier  Supplier      @relation(fields: [supplierId], references: [id])
  items     PurchaseItem[]
}

model PurchaseItem {
  id         String    @id @default(cuid())
  purchaseId String
  productId  String
  qty        Int
  unitCost   Decimal
  subtotal   Decimal
  expiresAt  DateTime? // vencimiento de este lote comprado

  purchase Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])
  batches  ProductBatch[]
}

model ProductBatch {
  id             String    @id @default(cuid())
  productId      String
  businessId     String
  qty            Int       // cantidad restante en este lote
  unitCost       Decimal
  expiresAt      DateTime?
  purchaseItemId String?
  createdAt      DateTime  @default(now())

  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseItem PurchaseItem? @relation(fields: [purchaseItemId], references: [id], onDelete: SetNull)
}

model StockMove {
  id         String   @id @default(cuid())
  productId  String
  qty        Int
  reason     String
  reference  String?
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entity     String
  entityId   String?
  payload    Json?
  ip         String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PausedSale {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  payload    Json
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model CatalogProduct {
  id        String   @id @default(cuid())
  name      String
  brand     String?
  category  String?
  barcode   String?
  content   String?
  keywords  String?
}

// ===== Módulo de Sincronización con APIs de proveedores =====

model SyncConnection {
  id              String    @id @default(cuid())
  businessId      String
  provider        String    // "mondelez"
  name            String
  enabled         Boolean   @default(true)
  config          Json?     // credenciales/params del proveedor (ej. teléfono, password)
  priceMarkup     Decimal   @default(0)  // % de markup sobre el costo del proveedor -> precio de venta
  defaultMinStock Int       @default(0)
  autoSync        Boolean   @default(false)
  credentialsEncrypted String?
  sessionEncrypted String?
  sessionExpiresAt DateTime?
  syncFrequency   String    @default("manual")
  syncHourLocal   Int?
  columnsConfig   Json?
  lastSyncAt      DateTime?
  lastStatus      String?   // success | error | running
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items    SyncedProduct[]
  runs     SyncRun[]
  mondelezOrders MondelezOrder[]
  orders   SupplierOrder[]
  drafts   OrderDraft[]
  account  SupplierAccount?
}

model SupplierAccount {
  id              String   @id @default(cuid())
  connectionId    String   @unique
  businessId      String
  clienteId       String?
  razonSocial     String?
  balance         Decimal?
  creditLimit     Decimal?
  availableCredit Decimal?
  loyaltyPoints   Int?
  currency        String?  @default("ARS")
  updatedAt       DateTime @updatedAt

  connection SyncConnection           @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  invoices   SupplierInvoice[]
  movements  SupplierAccountMovement[]
  credits    SupplierCredit[]
}

model SupplierOrder {
  id              String    @id @default(cuid())
  connectionId    String
  businessId      String
  source          String    @default("harvested")
  externalOrderId String?
  status          String?
  total           Decimal?
  deliveryDate    DateTime?
  tracking        String?
  placedAt        DateTime?
  raw             Json?
  createdAt       DateTime  @default(now())

  connection SyncConnection      @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  items      SupplierOrderItem[]

  @@index([connectionId, source])
}

model SupplierOrderItem {
  id               String   @id @default(cuid())
  orderId          String
  syncedProductId  String?
  name             String?
  uom              String?
  qty              Int      @default(1)
  unitPrice        Decimal?
  total            Decimal?

  order SupplierOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model SupplierInvoice {
  id               String    @id @default(cuid())
  accountId        String
  number           String?
  date             DateTime?
  dueDate          DateTime?
  total            Decimal?
  saldoPendiente   Decimal?
  status           String?
  pdfUrl           String?
  raw              Json?

  account SupplierAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model SupplierAccountMovement {
  id             String    @id @default(cuid())
  accountId      String
  date           DateTime?
  type           String?
  reference      String?
  amount         Decimal?
  runningBalance Decimal?

  account SupplierAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model SupplierCredit {
  id              String    @id @default(cuid())
  accountId       String
  tipo            String?
  montoDisponible Decimal?
  montoUsado      Decimal?
  vencimiento     DateTime?
  condiciones     String?

  account SupplierAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model MondelezOrder {
  id           String    @id @default(cuid())
  connectionId String
  businessId   String
  externalId   String    // orderId de Mondelez
  sequence     String?
  status       String?
  statusText   String?
  total        Decimal?
  totalItems   Int?
  payment      String?
  shippingEta  String?
  creationDate DateTime?
  raw          Json?
  createdAt    DateTime  @default(now())

  connection SyncConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
}

model OrderDraft {
  id            String   @id @default(cuid())
  connectionId  String
  businessId    String
  status        String   @default("draft") // draft | confirmed | placing | placed | error
  items         Json     // [{ sku, ean, name, quantity }]
  resultOrderId String?
  message       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  connection SyncConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

model SyncedProduct {
  id              String    @id @default(cuid())
  businessId      String
  connectionId    String
  externalId      String    // VTEX productId
  sku             String?   // VTEX skuId
  ean             String?
  supplierRef     String?
  eanUnit         String?
  eanBox          String?
  allCodes        String?   // todos los códigos concatenados para filtrar por cualquiera
  name            String
  brand           String?
  category        String?
  subcategory     String?
  cost            Decimal?  // costo real del proveedor (B2B) si está disponible
  listPrice       Decimal?
  ivaAlicuota     Decimal?
  unitsPerDisplay String?
  displaysPerBox  String?
  retornable      Boolean?
  basePrice       Decimal?
  available       Boolean   @default(true)
  stock           Int?
  unitsPerBox     String?
  weight          String?
  format          String?
  flavor          String?
  presentation    String?
  imageUrl        String?
  link            String?
  raw             Json?     // payload completo del proveedor
  linkedProductId String?   // Product.id si ya fue importado
  syncedAt        DateTime  @default(now())

  connection SyncConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  variants   SyncedVariant[]
  priceHistory SyncedPriceHistory[]

  @@unique([connectionId, externalId])
}

model SyncedPriceHistory {
  id              String   @id @default(cuid())
  syncedProductId String
  connectionId    String
  cost            Decimal?
  listPrice       Decimal?
  sellingPrice    Decimal?
  capturedAt      DateTime @default(now())

  syncedProduct SyncedProduct @relation(fields: [syncedProductId], references: [id], onDelete: Cascade)

  @@index([syncedProductId, capturedAt])
}

model SyncedVariant {
  id              String   @id @default(cuid())
  syncedProductId String
  uom             String
  multiplier      Int      @default(1)
  skuId           String?
  refId           String?
  ean             String?
  listPrice       Decimal?
  sellingPrice    Decimal?
  priceWithTax    Decimal?
  cost            Decimal?
  stock           Int?
  taxAlicuota     Decimal?
  sellerId        String?
  erpStatus       String?

  syncedProduct SyncedProduct @relation(fields: [syncedProductId], references: [id], onDelete: Cascade)

  @@index([syncedProductId])
}

model SyncRun {
  id            String    @id @default(cuid())
  connectionId  String
  status        String    // running | success | error
  itemsFetched  Int       @default(0)
  itemsUpserted Int       @default(0)
  itemsImported Int       @default(0)
  message       String?
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?

  connection SyncConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

// ===== Módulo Figuritas Mundial 2026 =====

model StickerCountry {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  code        String?  // ARG, BRA, FRA...
  flag        String?  // emoji
  flagUrl     String?  // URL alternativa a emoji
  priceUnit   Decimal  @default(0)  // precio venta unitario
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stickers Sticker[]

  @@unique([businessId, name])
}

model Sticker {
  id         String   @id @default(cuid())
  businessId String
  countryId  String
  number     Int      // número dentro del país (1, 2, 3...)
  stock      Int      @default(0)
  priceUnit  Decimal? // null = hereda precio del país
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  country      StickerCountry     @relation(fields: [countryId], references: [id], onDelete: Cascade)
  orderItems   StickerOrderItem[]

  @@unique([businessId, countryId, number])
}

model StickerCatalogShare {
  id         String   @id @default(cuid())
  businessId String   @unique
  token      String   @unique @default(cuid())
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model StickerOrder {
  id          String   @id @default(cuid())
  businessId  String
  shareId     String
  buyerName   String?
  buyerPhone  String?
  notes       String?
  status      String   @default("pending") // pending | confirmed | delivered | cancelled
  total       Decimal  @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items    StickerOrderItem[]
}

model StickerOrderItem {
  id        String  @id @default(cuid())
  orderId   String
  stickerId String
  qty       Int
  unitPrice Decimal

  order   StickerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sticker Sticker      @relation(fields: [stickerId], references: [id])
}

model SupportTicket {
  id         String    @id @default(cuid())
  businessId String
  userId     String
  subject    String
  category   String    @default("otro") // pago | bug | cuenta | otro
  status     String    @default("open") // open | in_progress | waiting | resolved | closed
  priority   String    @default("normal") // low | normal | high
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  closedAt   DateTime?

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id])
  messages SupportMessage[]

  @@index([businessId, createdAt])
  @@index([status, createdAt])
}

model SupportMessage {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  fromStaff Boolean  @default(false)
  body      String
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id])

  @@index([ticketId, createdAt])
}

/** Catálogo cacheado de Precios Claros / SEPA (global, ~EAN únicos). */
model PreciosClarosCatalog {
  ean          String   @id
  name         String
  brand        String?
  presentation String?
  priceMin     Decimal?
  priceMax     Decimal?
  nameNorm     String
  syncedAt     DateTime @default(now()) @updatedAt

  @@index([nameNorm])
  @@index([brand])
  @@index([syncedAt])
}

