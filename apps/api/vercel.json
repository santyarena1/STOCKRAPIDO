{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "NODE_ENV=development npm install --include=dev --legacy-peer-deps",
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/**",
      "maxDuration": 120
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.js" }
  ],
  "crons": [
    { "path": "/sync/cron", "schedule": "0 6 * * *" },
    { "path": "/data-admin/purge-cron", "schedule": "0 7 * * *" }
  ]
}
